    END
END

/////////////////////////////////////////////////////////////////////////////

// One LzSA archive with all embedded files (see resource.h), packed by the
// prebuild (cmd\pack-embedded-prebuild.cmd) into out\<cfg>\ and passed in via
// the EMBEDDED_PAK resdefine (premake5.lua): embedded-static.lzsa for the
// static build, embedded.lzsa (also holding libsumatrapdf.dll & co) for the
// dll/installer build. PdfPreview.dll & co read it from Swiftleaf.exe next to
// them (src/EmbeddedResources.cpp), so the fonts\* entries serve them too.
#ifndef EMBEDDED_PAK
#error EMBEDDED_PAK not defined (path of the out\<cfg>\embedded*.lzsa archive)
#endif
IDR_EMBEDDED_PAK        RCDATA               QM(EMBEDDED_PAK)

/////////////////////////////////////////////////////////////////////////////

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_SUMATRAPDF          ICON "gfx\\Swiftleaf.ico"
// for compath with pre 3.4 registry association for pre-win10
// have icon as ,1, which is index of this icon. unless we delete
// those old registry on install, the icon would change
2                       ICON "gfx\\Swiftleaf.ico"
// Document-type icons (resource id = registry DefaultIcon ,-N). See RegisterForOpenWith.
3                       ICON "gfx\\epub-32bit.ico"
4                       ICON "gfx\\cbx-32bit.ico"
5                       ICON "gfx\\chm-32bit.ico"
6                       ICON "gfx\\djvu-32bit.ico"
7                       ICON "gfx\\img-32bit.ico"
8                       ICON "gfx\\pdf-32bit.ico"
9                       ICON "gfx\\mobi-32bit.ico"

    /////////////////////////////////////////////////////////////////////////////

IDB_RELOADING_CUE       BITMAP                  "reloading.bmp"

