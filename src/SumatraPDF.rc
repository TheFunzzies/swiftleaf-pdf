IDD_FORM_FIELD DIALOGEX 0, 0, 500, 310
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Field properties"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "&Type:", IDC_FIELD_TYPE_LABEL, 10, 12, 78, 12
    COMBOBOX IDC_FIELD_TYPE, 90, 10, 200, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "&Name:", IDC_FIELD_NAME_LABEL, 10, 38, 78, 12
    EDITTEXT IDC_FIELD_NAME, 90, 36, 200, 14, ES_AUTOHSCROLL
    LTEXT "&Default value:", IDC_FIELD_DEFAULT_LABEL, 10, 64, 78, 12
    EDITTEXT IDC_FIELD_DEFAULT, 90, 62, 200, 14, ES_AUTOHSCROLL
    LTEXT "&Font size (0 = auto):", IDC_FIELD_SIZE_LABEL, 10, 90, 78, 22
    EDITTEXT IDC_FIELD_SIZE, 90, 88, 60, 14, ES_AUTOHSCROLL
    LTEXT "&Options (one per line):", IDC_FIELD_OPTIONS_LABEL, 10, 116, 78, 24
    EDITTEXT IDC_FIELD_OPTIONS, 90, 114, 200, 60, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL
    CONTROL "&Required", IDC_FIELD_REQUIRED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 90, 184, 90, 12
    CONTROL "Read-&only", IDC_FIELD_READONLY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 190, 184, 100, 12
    LTEXT "RGB colors: 0 to 1. Fonts: Helv / Cour / TiRo. Button action: reset / submit / link. Image: enter a local path in Target. Format is descriptive only (no JavaScript).", IDC_FIELD_HINT, 10, 252, 480, 28
    LTEXT "Tooltip:", -1, 310, 12, 65, 12
    EDITTEXT IDC_FIELD_TOOLTIP, 375, 10, 115, 14, ES_AUTOHSCROLL
    LTEXT "Font:", -1, 310, 38, 65, 12
    EDITTEXT IDC_FIELD_FONT, 375, 36, 115, 14, ES_AUTOHSCROLL
    LTEXT "Text RGB:", -1, 310, 64, 65, 12
    EDITTEXT IDC_FIELD_TEXTCOLOR, 375, 62, 115, 14, ES_AUTOHSCROLL
    LTEXT "Border RGB:", -1, 310, 90, 65, 12
    EDITTEXT IDC_FIELD_BORDERCOLOR, 375, 88, 115, 14, ES_AUTOHSCROLL
    LTEXT "Fill RGB:", -1, 310, 116, 65, 12
    EDITTEXT IDC_FIELD_BGCOLOR, 375, 114, 115, 14, ES_AUTOHSCROLL
    LTEXT "Border width:", -1, 310, 142, 65, 12
    EDITTEXT IDC_FIELD_BORDER, 375, 140, 115, 14, ES_AUTOHSCROLL
    LTEXT "Max length:", -1, 310, 168, 65, 12
    EDITTEXT IDC_FIELD_MAXLEN, 375, 166, 115, 14, ES_AUTOHSCROLL
    CONTROL "Multiline", IDC_FIELD_MULTILINE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 310, 190, 90, 12
    CONTROL "Comb", IDC_FIELD_COMB, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 410, 190, 80, 12
    LTEXT "Format:", -1, 10, 210, 78, 12
    EDITTEXT IDC_FIELD_FORMAT, 90, 208, 200, 14, ES_AUTOHSCROLL
    LTEXT "Action:", -1, 310, 210, 65, 12
    EDITTEXT IDC_FIELD_ACTION, 375, 208, 115, 14, ES_AUTOHSCROLL
    LTEXT "Target:", -1, 10, 234, 78, 12
    EDITTEXT IDC_FIELD_TARGET, 90, 232, 400, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON "OK", IDOK, 380, 286, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 440, 286, 50, 14
END

IDD_PROPSHEET_PRINT_ADVANCED DIALOGEX 0, 0, 292, 194
