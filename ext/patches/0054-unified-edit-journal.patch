+static void
+write_fragment(fz_context *ctx, fz_output *out, pdf_journal_fragment *frag)
+{
+	if (frag->newobj)
+	{
+		fz_write_printf(ctx, out, "%d 0 newobj\n", frag->obj_num);
+		return;
+	}
+	fz_write_printf(ctx, out, "%d 0 obj\n", frag->obj_num);
+	pdf_print_encrypted_obj(ctx, out, frag->inactive, 1, 0, NULL, frag->obj_num, 0, NULL);
+	if (frag->stream)
+	{
+		fz_write_string(ctx, out, "\nstream\n");
+		fz_write_data(ctx, out, frag->stream->data, frag->stream->len);
+		fz_write_string(ctx, out, "\nendstream");
+	}
+	fz_write_string(ctx, out, "\nendobj\n");
+}
+
+static void
+load_journal_entry(fz_context *ctx, pdf_document *doc, pdf_journal_entry *entry)
+{
+	fz_stream *stm;
+	pdf_journal_entry loaded = { 0 };
+	if (!entry->spill_path)
+		return;
+	stm = fz_open_file(ctx, entry->spill_path);
+	fz_var(loaded);
+	fz_try(ctx)
+	{
+		while (1)
+		{
+			pdf_journal_fragment *frag;
+			fz_skip_space(ctx, stm);
+			if (fz_is_eof(ctx, stm))
+				break;
+			frag = fz_malloc_struct(ctx, pdf_journal_fragment);
+			frag->prev = loaded.tail;
+			if (loaded.tail) loaded.tail->next = frag;
+			else loaded.head = frag;
+			loaded.tail = frag;
+			frag->inactive = pdf_parse_journal_obj(ctx, doc, stm, &frag->obj_num, &frag->stream, &frag->newobj);
+			pdf_set_obj_parent(ctx, frag->inactive, frag->obj_num);
+		}
+	}
+	fz_always(ctx)
+		fz_drop_stream(ctx, stm);
+	fz_catch(ctx)
+	{
+		discard_fragments(ctx, loaded.head);
+		fz_rethrow(ctx);
+	}
+	entry->head = loaded.head;
+	entry->tail = loaded.tail;
+	fz_remove_utf8(entry->spill_path);
+	fz_free(ctx, entry->spill_path);
+	entry->spill_path = NULL;
+}
+
+static size_t
+journal_object_size(pdf_obj *obj, int depth)
+{
+	size_t size = sizeof(pdf_obj);
+	int i;
+	if (obj < PDF_LIMIT || depth > 100)
+		return size;
+	switch (obj->kind)
+	{
+	case PDF_STRING: return sizeof(pdf_obj_string) + STRING(obj)->len;
+	case PDF_ARRAY:
+		size += sizeof(pdf_obj_array) + ARRAY(obj)->len * sizeof(pdf_obj *);
+		for (i = 0; i < ARRAY(obj)->len; ++i)
+			size += journal_object_size(ARRAY(obj)->items[i], depth + 1);
+		break;
+	case PDF_DICT:
+		size += sizeof(pdf_obj_dict) + DICT(obj)->len * sizeof(struct keyval);
+		for (i = 0; i < DICT(obj)->len; ++i)
+			size += journal_object_size(DICT(obj)->items[i].v, depth + 1);
+		break;
+	default: break;
+	}
+	return size;
+}
+
+static size_t
+journal_entry_size(pdf_journal_entry *entry)
+{
+	size_t size = 0;
+	pdf_journal_fragment *frag;
+	for (frag = entry->head; frag; frag = frag->next)
+		size += sizeof(*frag) + journal_object_size(frag->inactive, 0) + (frag->stream ? frag->stream->len : 0);
+	return size;
+}
+
+size_t pdf_journal_memory(fz_context *ctx, pdf_document *doc)
+{
+	size_t size = 0;
+	pdf_journal_entry *entry;
+	if (doc && doc->journal)
+		for (entry = doc->journal->head; entry; entry = entry->next)
+			size += journal_entry_size(entry);
+	return size;
+}
+
+uint64_t pdf_journal_position(fz_context *ctx, pdf_document *doc)
+{
+	return doc && doc->journal && doc->journal->current ? doc->journal->current->serial : 0;
+}
+
+static void
+limit_journal(fz_context *ctx, pdf_document *doc)
+{
+	pdf_journal *journal = doc->journal;
+	pdf_journal_entry *entry;
+	size_t size;
+	if (!journal || !journal->spill_prefix || journal->nesting || journal->pending)
+		return;
+	size = pdf_journal_memory(ctx, doc);
+	for (entry = journal->head; entry && size > journal->budget; entry = entry->next)
+	{
+		fz_output *out = NULL;
+		char *path = NULL;
+		pdf_journal_fragment *frag;
+		size_t bytes = journal_entry_size(entry);
+		if (!bytes) continue;
+		fz_var(out);
+		fz_var(path);
+		fz_try(ctx)
+		{
+			path = fz_asprintf(ctx, "%s-%u.undo", journal->spill_prefix, ++journal->spill_id);
+			out = fz_new_output_with_path(ctx, path, 0);
+			for (frag = entry->head; frag; frag = frag->next)
+				write_fragment(ctx, out, frag);
+			fz_close_output(ctx, out);
+		}
+		fz_always(ctx)
+			fz_drop_output(ctx, out);
+		fz_catch(ctx)
+		{
+			if (path) fz_remove_utf8(path);
+			fz_free(ctx, path);
+			fz_report_error(ctx);
+			return; /* Keep the in-memory history if the disk is full. */
+		}
+		entry->spill_path = path;
+		discard_fragments(ctx, entry->head);
+		entry->head = entry->tail = NULL;
+		size -= bytes;
+	}
+}
+
+void pdf_set_journal_storage(fz_context *ctx, pdf_document *doc, const char *prefix, size_t budget)
+{
+	if (!doc || !doc->journal || !prefix || !*prefix)
+		return;
+	if (!doc->journal->spill_prefix)
+		doc->journal->spill_prefix = fz_strdup(ctx, prefix);
+	else if (doc->journal->budget == budget)
+		return;
+	doc->journal->budget = budget;
+	limit_journal(ctx, doc);
+}
