Keep Windows PDF writes atomic, including command-line tools

Write and close a sibling, flush its bytes, then publish with a same-volume
rename. Failure never truncates the destination. Stdout remains a stream.
---
diff --git a/source/pdf/pdf-write.c b/source/pdf/pdf-write.c
--- a/source/pdf/pdf-write.c
+++ b/source/pdf/pdf-write.c
@@ -31,6 +31,10 @@
 #include <string.h>
 
 #include <stdio.h> /* for debug printing */
+#ifdef _WIN32
+#include <windows.h>
+#include <wchar.h>
+#endif
 /* #define DEBUG_HEAP_SORT */
 /* #define DEBUG_WRITING */
 /* #define DEBUG_MARK_AND_SWEEP */
@@ -2949,7 +2953,7 @@
 	do_pdf_save_document(ctx, doc, &opts, in_opts);
 }
 
-void pdf_save_document(fz_context *ctx, pdf_document *doc, const char *filename, const pdf_write_options *in_opts)
+static void pdf_save_document_imp(fz_context *ctx, pdf_document *doc, const char *filename, const pdf_write_options *in_opts)
 {
 	pdf_write_options opts_defaults = pdf_default_write_options;
 	pdf_write_state opts = { 0 };
@@ -3042,6 +3046,71 @@
 	{
 		fz_rethrow(ctx);
 	}
+}
+
+/* Keep command-line writers atomic too; the app also stages its own outputs. */
+void pdf_save_document(fz_context *ctx, pdf_document *doc, const char *filename, const pdf_write_options *in_opts)
+{
+#ifdef _WIN32
+	wchar_t *name = NULL;
+	wchar_t full[MAX_PATH];
+	wchar_t dir[MAX_PATH];
+	wchar_t temporary[MAX_PATH] = { 0 };
+	wchar_t *base;
+	char *staged = NULL;
+	DWORD size;
+	HANDLE file;
+	BOOL flushed;
+	DWORD error;
+
+	if (!doc)
+		return;
+	if (!filename || !strcmp(filename, "-"))
+	{
+		pdf_save_document_imp(ctx, doc, filename, in_opts);
+		return;
+	}
+
+	fz_var(name);
+	fz_var(staged);
+	fz_var(temporary);
+	fz_try(ctx)
+	{
+		name = fz_wchar_from_utf8(ctx, filename);
+		size = GetFullPathNameW(name, MAX_PATH, full, &base);
+		if (!size || size >= MAX_PATH || !base)
+			fz_throw(ctx, FZ_ERROR_SYSTEM, "cannot resolve PDF destination");
+		memcpy(dir, full, (base - full) * sizeof(wchar_t));
+		dir[base - full] = 0;
+		if (!GetTempFileNameW(dir, L"slf", 0, temporary))
+			fz_throw(ctx, FZ_ERROR_SYSTEM, "cannot stage PDF: error %lu", GetLastError());
+		staged = fz_utf8_from_wchar(ctx, temporary);
+		pdf_save_document_imp(ctx, doc, staged, in_opts);
+		file = CreateFileW(temporary, GENERIC_READ | GENERIC_WRITE, 0, NULL, OPEN_EXISTING,
+			FILE_ATTRIBUTE_NORMAL, NULL);
+		if (file == INVALID_HANDLE_VALUE)
+			fz_throw(ctx, FZ_ERROR_SYSTEM, "cannot flush PDF: error %lu", GetLastError());
+		flushed = FlushFileBuffers(file);
+		error = GetLastError();
+		CloseHandle(file);
+		if (!flushed)
+			fz_throw(ctx, FZ_ERROR_SYSTEM, "cannot flush PDF: error %lu", error);
+		if (!MoveFileExW(temporary, full, MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH))
+			fz_throw(ctx, FZ_ERROR_SYSTEM, "cannot replace PDF: error %lu", GetLastError());
+		temporary[0] = 0;
+	}
+	fz_always(ctx)
+	{
+		if (temporary[0])
+			DeleteFileW(temporary);
+		fz_free(ctx, staged);
+		fz_free(ctx, name);
+	}
+	fz_catch(ctx)
+		fz_rethrow(ctx);
+#else
+	pdf_save_document_imp(ctx, doc, filename, in_opts);
+#endif
 }
 
