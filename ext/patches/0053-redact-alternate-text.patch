Remove alternate text from redacted content

Redaction must not retain ActualText/Alt copies in inline or named marked-
content properties. Drop these text properties only in redaction filters;
ordinary content cleaning retains them. Also write edited structure ActualText
back to its own key and pass the resolved BDC dictionary down the filter chain.
---
diff --git a/include/mupdf/pdf/interpret.h b/include/mupdf/pdf/interpret.h
index d643a45..e576207 100644
--- a/include/mupdf/pdf/interpret.h
+++ b/include/mupdf/pdf/interpret.h
@@ -383,6 +383,7 @@ typedef struct
 	int (*text_filter)(fz_context *ctx, void *opaque, int *ucsbuf, int ucslen, fz_matrix trm, fz_matrix ctm, fz_rect bbox, int tr, float ca, float CA);
 	void (*after_text_object)(fz_context *ctx, void *opaque, pdf_document *doc, pdf_processor *chain, fz_matrix ctm);
 	int (*culler)(fz_context *ctx, void *opaque, fz_rect bbox, fz_cull_type type);
+	int sanitize_text_metadata;
 }
 pdf_sanitize_filter_options;
 
diff --git a/source/pdf/pdf-clean.c b/source/pdf/pdf-clean.c
index c257e12..69321be 100644
--- a/source/pdf/pdf-clean.c
+++ b/source/pdf/pdf-clean.c
@@ -1117,6 +1117,7 @@ void init_redact_filter(fz_context *ctx, pdf_redact_options *redact_opts, struct
 	red->text = text;
 
 	red->sanitize_opts.opaque = red;
+	red->sanitize_opts.sanitize_text_metadata = 1;
 	if (text == PDF_REDACT_TEXT_REMOVE)
 		red->sanitize_opts.text_filter = pdf_redact_text_filter;
 	if (text == PDF_REDACT_TEXT_REMOVE_INVISIBLE)
diff --git a/source/pdf/pdf-op-filter.c b/source/pdf/pdf-op-filter.c
index 7382011..1433f23 100644
--- a/source/pdf/pdf-op-filter.c
+++ b/source/pdf/pdf-op-filter.c
@@ -922,7 +922,7 @@ update_mcid(fz_context *ctx, pdf_sanitize_processor *p)
 	if (tag->alt.edited)
 		pdf_dict_put_text_string(ctx, tag->mcid_obj, PDF_NAME(Alt), tag->alt.utf8 ? tag->alt.utf8 : "");
 	if (tag->actualtext.edited)
-		pdf_dict_put_text_string(ctx, tag->mcid_obj, PDF_NAME(Alt), tag->actualtext.utf8 ? tag->actualtext.utf8 : "");
+		pdf_dict_put_text_string(ctx, tag->mcid_obj, PDF_NAME(ActualText), tag->actualtext.utf8 ? tag->actualtext.utf8 : "");
 }
 
 /* Process a string (from buf, of length len), from position *pos onwards.
@@ -2684,10 +2684,23 @@ pdf_filter_MP(fz_context *ctx, pdf_processor *proc, const char *tag)
 		p->super.chain->op_MP(ctx, p->super.chain, tag);
 }
 
+static void
+sanitize_tag_text(fz_context *ctx, pdf_sanitize_processor *p, pdf_obj *properties)
+{
+	if (!p->options->sanitize_text_metadata || !pdf_is_dict(ctx, properties))
+		return;
+	/* Alternate text can retain content removed from the page stream. */
+	pdf_dict_del(ctx, properties, PDF_NAME(ActualText));
+	pdf_dict_del(ctx, properties, PDF_NAME(Alt));
+	pdf_dict_del(ctx, properties, PDF_NAME(E));
+	pdf_dict_del(ctx, properties, PDF_NAME(T));
+}
+
 static void
 pdf_filter_DP(fz_context *ctx, pdf_processor *proc, const char *tag, pdf_obj *raw, pdf_obj *cooked)
 {
 	pdf_sanitize_processor *p = (pdf_sanitize_processor*)proc;
+	sanitize_tag_text(ctx, p, cooked);
 
 	if (fz_is_empty_rect(p->gstate->clip_rect))
 		return;
@@ -2733,7 +2746,8 @@ pdf_filter_BDC(fz_context *ctx, pdf_processor *proc, const char *tag, pdf_obj *r
 		bdc->bdc = 1;
 		bdc->tag = fz_strdup(ctx, tag);
 		bdc->raw = pdf_keep_obj(ctx, raw);
-		bdc->cooked = pdf_keep_obj(ctx, raw);
+		bdc->cooked = pdf_keep_obj(ctx, cooked);
+		sanitize_tag_text(ctx, p, cooked);
 	}
 	fz_catch(ctx)
 	{
